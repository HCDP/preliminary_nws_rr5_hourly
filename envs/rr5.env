# Directory configuration for the RR5 hourly rainfall workflow — source this before
# running either script:
#
#   . /path/to/preliminary_nws_rr5_hourly/envs/rr5.env
#   Rscript "$RR5_CODE_DIR/..."
#
# RR5_PROJECT_ROOT is REQUIRED; the scripts abort if it is unset. The three
# directory variables are optional and default to the conventional
# subdirectories of the root, so in a standard deployment the root alone is
# enough. Set them only to split code and data across filesystems.
#
# The names are deliberately RR5_-prefixed rather than the bare
# PROJECT_ROOT the MADIS workflow uses, so no two of these workflows can
# collide in a shell or crontab that has more than one loaded.

export RR5_PROJECT_ROOT=/home/hawaii_climate_products_container/preliminary/data_aqs_hrly/preliminary_nws_rr5_hourly

# Optional overrides — defaults shown, uncomment to redirect.
# export RR5_CODE_DIR="$RR5_PROJECT_ROOT/code"
# export RR5_DATA_OUT="$RR5_PROJECT_ROOT/data_out"
# export RR5_DATA_CATALOG="$RR5_PROJECT_ROOT/dataCatalog"
